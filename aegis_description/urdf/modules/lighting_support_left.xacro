<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="lighting_support_left" params="parent prefix disable_cell_collision">
    <joint name="${prefix}lighting_support_left_joint" type="fixed">
      <origin xyz="0.50 0.30 1.171" rpy="0.0 0.0 ${-0.5 * pi}"/>
      <parent link="${parent}"/>
      <child link="${prefix}lighting_support_left_link"/>
    </joint>

    <link name="${prefix}lighting_support_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/lighting_support_left.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>

      <xacro:unless value="${disable_cell_collision}">
        <collision>
          <origin xyz="-0.277 0.007 -0.015" rpy="0 0 0"/>
          <geometry>
            <box size="0.6 0.07 0.16"/>
          </geometry>
        </collision>
      </xacro:unless>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/lighting_support_left.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>
