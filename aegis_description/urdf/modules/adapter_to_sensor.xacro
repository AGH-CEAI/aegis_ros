<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find aegis_description)/urdf/cylinders_inertial.xacro"/>

  <xacro:macro name="adapter_to_sensor" params="prefix parent">
    <xacro:property name="mass" value="0.242"/>
    <xacro:property name="radius1" value="0.03025"/>
    <xacro:property name="height1" value="0.0116"/>
    <xacro:property name="radius2" value="0.04255"/>
    <xacro:property name="height2" value="0.0094"/>

    <xacro:property name="height_to_adapter" value="0.0135"/>
    <xacro:property name="height_total" value="0.0210"/>
    <xacro:property name="width" value="0.0860"/>

    <joint name="${prefix}adapter_to_sensor_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}adapter_to_sensor"/>
    </joint>

    <link name="${prefix}adapter_to_sensor">
      <visual>
        <origin xyz="0 0 ${height_total}" rpy="0 ${pi} ${pi}"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/adapter_to_sensor.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1.9e-3"/>
      </inertial>
      <collision>
        <origin xyz="0 0 ${0.5 * height_total}" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${width} ${height_total}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}adapter_to_sensor_end_joint" type="fixed">
      <origin xyz="0 0 ${height_total}" rpy="0 0 0"/>
      <parent link="${prefix}adapter_to_sensor"/>
      <child link="${prefix}adapter_to_sensor_end"/>
    </joint>

    <link name="${prefix}adapter_to_sensor_end"/>

    <joint name="${prefix}adapter_to_mount_camera_tool_right_joint" type="fixed">
      <origin xyz="0 0 ${height_to_adapter}" rpy="0 ${pi} 0"/>
      <parent link="${prefix}adapter_to_sensor"/>
      <child link="${prefix}adapter_to_mount_camera_tool_right"/>
    </joint>

    <link name="${prefix}adapter_to_mount_camera_tool_right"/>

    <joint name="${prefix}adapter_to_mount_camera_tool_left_joint" type="fixed">
      <origin xyz="0 0 ${height_to_adapter}" rpy="0 ${pi} ${pi}"/>
      <parent link="${prefix}adapter_to_sensor"/>
      <child link="${prefix}adapter_to_mount_camera_tool_left"/>
    </joint>

    <link name="${prefix}adapter_to_mount_camera_tool_left"/>
  </xacro:macro>
</robot>
