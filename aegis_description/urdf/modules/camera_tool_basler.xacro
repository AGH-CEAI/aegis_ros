<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="camera_tool_basler" params="prefix parent side">
    <xacro:property name="camera_mass" value="0.217"/>
    <xacro:property name="camera_mounting_offset" value="-0.0387"/>
    <xacro:property name="camera_height" value="0.0290"/>
    <xacro:property name="camera_length" value="0.0603"/>
    <xacro:property name="lens_offset" value="-0.0145"/>

    <joint name="${prefix}camera_${side}_joint" type="fixed">
      <origin xyz="0 ${0.5 * camera_height} ${camera_mounting_offset}" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}cam_tool_${side}_basler"/>
    </joint>

    <link name="${prefix}cam_tool_${side}_basler">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/camera_tool_basler.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <!-- TODO(issue#46): Fix inertial parameters for tool cameras -->
      <inertial>
        <mass value="${camera_mass}"/>
        <inertia ixx="0.3403" ixy="0.0" ixz="0.0" iyy="0.3403" iyz="0.0" izz="0.039606138"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>
