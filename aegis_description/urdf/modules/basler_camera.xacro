<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- <xacro:include filename="$(find aegis_description)/urdf/cylinders_inertial.xacro"/> -->

  <xacro:macro name="basler_camera" params="prefix parent side">
    <xacro:property name="camera_mass" value="0.217"/>
    <xacro:property name="lens_mass" value="0.063"/>
    <xacro:property name="camera_mounting_offset" value="0.0387"/>
    <xacro:property name="camera_height" value="0.0290"/>
    <xacro:property name="camera_length" value="0.0603"/>
    <xacro:property name="lens_radius" value="0.01660"/>
    <xacro:property name="lens_height" value="0.02890"/>
    <xacro:property name="lens_offset" value="-0.0145"/>

    <joint name="basler_camera_joint_${side}" type="fixed">
      <origin xyz="0 ${0.5 * camera_height} ${-camera_mounting_offset}" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}basler_camera_${side}"/>
    </joint>

    <link name="${prefix}basler_camera_${side}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/basler_camera.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <visual>
        <origin xyz="0 0 ${lens_offset}" rpy="0 0 ${pi}"/>
        <geometry>
          <cylinder radius="${lens_radius}" length="${lens_height}"/>
        </geometry>
        <material name="black">
          <color rgba="0.04 0.04 0.04 1"/>
        </material>
      </visual>
      <!-- <xacro:cylinders_inertial r1="${radius1}" l1="${height1}" r2="${radius2}" l2="${height2}" m="${mass}"/> -->
      <collision>
        <origin xyz="0 0 ${0.5 * camera_length}" rpy="0 0 0"/>
        <geometry>
            <box size="${camera_height} ${camera_height} ${camera_length}" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 ${lens_offset}" rpy="0 0 ${pi}"/>
        <geometry>
          <cylinder radius="${lens_radius}" length="${lens_height}"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>
</robot>
