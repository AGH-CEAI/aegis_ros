<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wled_lights_right" params="parent prefix">
    
    <joint name="${prefix}wled_lights_right_joint" type="fixed">
      <origin xyz="0.32 0.50 0.35" rpy="0.0 0.0 ${pi}"/>
      <parent link="${parent}"/>
      <child link="${prefix}wled_lights_right_link"/>
    </joint>

    <link name="${prefix}wled_lights_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/wled_lights_right.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aegis_description/meshes/wled_lights_right.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>